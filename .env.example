# คัดลอกเป็น .env แล้วใส่ค่าจริง — ไฟล์นี้ต้องเป็น placeholder เท่านั้น (tests/repo-hygiene.test.ts ตรวจอยู่)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
NUXT_DATABASE_URL=postgresql://postgres.xxxxxxxxxxxxxxxxxxxx:yyyyyyyy@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# secret key: ใช้ได้ที่ server/utils/privileged.ts ที่เดียว (ADR-0005)
NUXT_SUPABASE_SECRET_KEY=
NUXT_TRY_ON_PROVIDER=mock
NUXT_TRY_ON_WEBHOOK_SECRET=
NUXT_TRY_ON_MOCK_FAIL_RATE=0
# เจ้าจริง (ADR-0008) — fal.ai API key: https://fal.ai/dashboard/keys
NUXT_FAL_API_KEY=
NUXT_CRON_SECRET=
NUXT_PUBLIC_SITE_URL=http://localhost:3000
# S17 Web Push — สร้างด้วย `npx web-push generate-vapid-keys`
NUXT_VAPID_PRIVATE_KEY=
NUXT_VAPID_SUBJECT=mailto:xxxxxxxxxxxxxxxxxxxx@example.com
NUXT_PUBLIC_VAPID_PUBLIC_KEY=
